# Generated by init-workflow 5.0.2 from .hskill/init-workflow/workflow-config.yml; do not edit, rerun init-workflow
schema=1
rule_file=.hskill/init-workflow/workflow-config.yml
integration_branches=main staging
base.feature=staging
base.fix=staging
base.chore=staging
base.doc=staging
base.release=main
merge_target=staging
merge_script=scripts/merge-to-staging.sh
merge_trailer=Merge-Via: merge-to-staging.sh
worktree_dir=.worktrees
naming.1=^feature/.+
naming.2=^fix/.+
naming.3=^chore/.+
naming.4=^doc/.+
naming.5=^release/[0-9]+\.[0-9]+\.[0-9]+(-.+)?$
naming_exempt=main staging
