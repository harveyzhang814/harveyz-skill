#!/usr/bin/env bats

SCRIPT="${BATS_TEST_DIRNAME}/../scripts/inspect-worktree.sh"

setup() {
  TMP="$(mktemp -d)"; cd "$TMP" || exit 1; TMP="$(pwd -P)"
  git init -q -b main repo && cd repo
  git config user.email t@example.com && git config user.name t
  echo x > seed.txt && git add seed.txt && git commit -qm seed
  REPO="$TMP/repo"
}
teardown() { [[ -n "${TMP:-}" && "$TMP" == /*/* ]] && rm -rf "$TMP"; }

# resolved.env 夹具：write_env <仓库目录> [worktree_dir]，写到固定路径但不提交
write_env() {
  mkdir -p "$1/.hskill/init-workflow"
  cat > "$1/.hskill/init-workflow/resolved.env" <<ENV
# Generated by init-workflow 5.0.0 from .hskill/init-workflow/workflow-config.yml; do not edit, rerun init-workflow
schema=1
rule_file=.hskill/init-workflow/workflow-config.yml
integration_branches=main staging
base.feature=staging
base.fix=staging
base.chore=staging
base.doc=staging
base.release=main
merge_target=staging
merge_script=scripts/merge-to-staging.sh
merge_trailer=Merge-Via: merge-to-staging.sh
worktree_dir=${2:-.worktrees}
naming.1=^feature/.+
naming_exempt=main staging
ENV
}
# 部署：在 main 上提交 resolved.env，并让 staging 分支带上它（基线分支上有已提交的一份）
deploy() { # deploy [worktree_dir]
  write_env "$REPO" "${1:-}"
  git -C "$REPO" add -A && git -C "$REPO" commit -qm deploy
  git -C "$REPO" branch -f staging main
}
linked() { git -C "$REPO" worktree add -q -b "$1" "$TMP/wt" HEAD >/dev/null; echo "$TMP/wt"; }

@test "01 non-git directory -> exit 3, verdict n/a" {
  mkdir "$TMP/plain"
  run bash "$SCRIPT" --path "$TMP/plain"
  [ "$status" -eq 3 ]; [[ "$output" == *"verdict=n/a"* ]] || false
}

@test "02 main worktree on a feature branch is not linked -> exit 1" {
  deploy
  git -C "$REPO" checkout -q -b feature/x
  run bash "$SCRIPT" --path "$REPO"
  [ "$status" -eq 1 ]; [[ "$output" == *"linked=no"* ]] || false; [[ "$output" == *"reason=not-linked"* ]] || false
}

@test "03 linked worktree on feature branch without hooks -> pass" {
  deploy
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 0 ]; [[ "$output" == *"verdict=pass"* ]] || false; [[ "$output" == *"hooks=n/a"* ]] || false
  [[ "$output" == *"resolved=.hskill/init-workflow/resolved.env"* ]] || false; [[ "$output" == *"base=staging"* ]] || false
}

@test "04 detached linked worktree -> exit 1, detached" {
  deploy
  git -C "$REPO" worktree add -q --detach "$TMP/wt" HEAD
  run bash "$SCRIPT" --path "$TMP/wt"
  [ "$status" -eq 1 ]; [[ "$output" == *"detached=yes"* ]] || false; [[ "$output" == *"reason=detached"* ]] || false
}

@test "no resolved.env anywhere -> exit 4 workflow-not-deployed" {
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 4 ]
  [[ "$output" == *"resolved=missing"* ]] || false
  [[ "$output" == *"verdict=n/a"* ]] || false
  [[ "$output" == *"reason=workflow-not-deployed"* ]] || false
}

@test "values come from resolved.env committed on the base branch" {
  deploy
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt" --type feature --branch feature/foo
  [ "$status" -eq 0 ]
  [[ "$output" == *"resolved=.hskill/init-workflow/resolved.env"* ]] || false
  [[ "$output" == *"integration=main staging"* ]] || false
  [[ "$output" == *"is_integration=no"* ]] || false
  [[ "$output" == *"base=staging"* ]] || false
  [[ "$output" == *"merge_target=staging"* ]] || false
  [[ "$output" == *"merge_script=scripts/merge-to-staging.sh"* ]] || false
  [[ "$output" == *"default_path=$REPO/.worktrees/feature+foo"* ]] || false
  [[ "$output" != *"rule_file="* ]] || false
}

@test "main worktree on another branch with different file still yields base-branch values" {
  wt="$(linked feature/x)"
  deploy
  git -C "$REPO" checkout -q -b feature/other
  sed -e 's/^integration_branches=.*/integration_branches=main/' \
      -e 's/^merge_target=.*/merge_target=elsewhere/' \
      -e 's/^worktree_dir=.*/worktree_dir=other-dir/' \
      "$REPO/.hskill/init-workflow/resolved.env" > "$TMP/other.env"
  cp "$TMP/other.env" "$REPO/.hskill/init-workflow/resolved.env"
  git -C "$REPO" add -A && git -C "$REPO" commit -qm other
  run bash "$SCRIPT" --path "$wt" --branch feature/foo
  [ "$status" -eq 0 ]
  [[ "$output" == *"integration=main staging"* ]] || false
  [[ "$output" == *"merge_target=staging"* ]] || false
  [[ "$output" == *"default_path=$REPO/.worktrees/feature+foo"* ]] || false
}

@test "worktree created before deployment still inspects via base branch" {
  wt="$(linked feature/x)"
  [ ! -e "$wt/.hskill/init-workflow/resolved.env" ]
  deploy
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 0 ]
  [[ "$output" == *"resolved=.hskill/init-workflow/resolved.env"* ]] || false
  [[ "$output" == *"integration=main staging"* ]] || false
  [[ "$output" == *"base=staging"* ]] || false
}

@test "base branch lacks the file while bootstrap copy exists -> exit 4" {
  git -C "$REPO" branch staging
  write_env "$REPO"
  git -C "$REPO" add -A && git -C "$REPO" commit -qm deploy-main-only
  wt="$(linked feature/x)"
  [ -f "$wt/.hskill/init-workflow/resolved.env" ]
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 4 ]
  [[ "$output" == *"resolved=missing"* ]] || false
  [[ "$output" == *"reason=workflow-not-deployed"* ]] || false
}

@test "custom worktree_dir shapes default_path" {
  deploy .trees
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt" --branch feature/foo
  [[ "$output" == *"default_path=$REPO/.trees/feature+foo"* ]] || false
}

@test "protected branch from resolved.env counts as integration" {
  deploy
  git -C "$REPO" worktree add -q "$TMP/wt" staging
  run bash "$SCRIPT" --path "$TMP/wt"
  [ "$status" -eq 1 ]
  [[ "$output" == *"is_integration=yes"* ]] || false
  [[ "$output" == *"reason=integration-branch"* ]] || false
}

@test "script never reads workflow-config.yml" {
  ! grep -q 'workflow-config.yml' "$SCRIPT"
}

@test "11 .githooks present but hooksPath unset -> hooks-missing; set -> pass" {
  deploy
  mkdir "$REPO/.githooks" && touch "$REPO/.githooks/pre-commit"
  git -C "$REPO" add -A && git -C "$REPO" commit -qm hooks
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 1 ]; [[ "$output" == *"hooks=missing"* ]] || false; [[ "$output" == *"reason=hooks-missing"* ]] || false
  git -C "$REPO" config core.hooksPath .githooks
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 0 ]; [[ "$output" == *"hooks=ok"* ]] || false
}

@test "12 subdirectory of a worktree is not root -> exit 1" {
  deploy
  wt="$(linked feature/x)"; mkdir "$wt/sub"
  run bash "$SCRIPT" --path "$wt/sub"
  [ "$status" -eq 1 ]; [[ "$output" == *"reason=not-root"* ]] || false
}

@test "14 unknown option -> exit 2" {
  run bash "$SCRIPT" --bogus
  [ "$status" -eq 2 ]
}

# ── hooksPath 的等价写法 ───────────────────────────────────────────────────
with_githooks() {
  deploy
  mkdir "$REPO/.githooks" && touch "$REPO/.githooks/pre-commit"
  git -C "$REPO" add -A && git -C "$REPO" commit -qm hooks
}

@test "15 hooksPath written as ./.githooks/ counts as configured" {
  with_githooks
  wt="$(linked feature/x)"
  git -C "$REPO" config core.hooksPath ./.githooks/
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 0 ]; [[ "$output" == *"hooks=ok"* ]] || false
}

@test "16 absolute hooksPath to the main worktree's .githooks counts as configured" {
  with_githooks
  wt="$(linked feature/x)"
  git -C "$REPO" config core.hooksPath "$REPO/.githooks"
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 0 ]; [[ "$output" == *"hooks=ok"* ]] || false
}

@test "17 hooksPath pointing elsewhere is still hooks-missing" {
  with_githooks
  mkdir "$TMP/elsewhere"
  wt="$(linked feature/x)"
  git -C "$REPO" config core.hooksPath "$TMP/elsewhere"
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 1 ]; [[ "$output" == *"reason=hooks-missing"* ]] || false
}

# ── reusable 与 default_path ───────────────────────────────────────────────
@test "19 reusable ignores hooks-missing but not linked/root/detached/integration" {
  with_githooks
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 1 ]; [[ "$output" == *"reason=hooks-missing"* ]] || false; [[ "$output" == *"reusable=yes"* ]] || false
  run bash "$SCRIPT" --path "$REPO"
  [[ "$output" == *"reusable=no"* ]] || false
  mkdir "$wt/sub"
  run bash "$SCRIPT" --path "$wt/sub"
  [[ "$output" == *"reusable=no"* ]] || false
}

@test "20 --branch gives default_path under the main worktree root, even from a linked worktree" {
  deploy
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt" --branch feature/foo
  [[ "$output" == *"default_path=$REPO/.worktrees/feature+foo"* ]] || false
}

@test "21 without --branch default_path is empty" {
  deploy
  run bash "$SCRIPT" --path "$REPO"
  [[ "$output" == *$'\ndefault_path=\n'* ]] || false
}

@test "22 --branch without a value -> exit 2" {
  run bash "$SCRIPT" --branch
  [ "$status" -eq 2 ]
}

# ── 不按默认分支兜底（I-1 c）：缺 base 输出空，缺集成分支视为无效 ───────────────
# deploy_edited <sed 表达式>：先按标准夹具写出，再用 sed 改写后提交（main 与 staging 都带上）
deploy_edited() {
  write_env "$REPO"
  sed -e "$1" "$REPO/.hskill/init-workflow/resolved.env" > "$TMP/edited.env"
  cp "$TMP/edited.env" "$REPO/.hskill/init-workflow/resolved.env"
  git -C "$REPO" add -A && git -C "$REPO" commit -qm deploy
  git -C "$REPO" branch -f staging main
}

@test "23 resolved.env without any base.* -> base is empty, never the default branch" {
  deploy_edited '/^base\./d'
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 0 ]
  [[ "$output" == *$'\nbase=\n'* ]] || false
  [[ "$output" != *"base=main"* ]] || false
  [[ "$output" == *"integration=main staging"* ]] || false
}

@test "24 --type absent from resolved.env -> base is empty" {
  deploy
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt" --type hotfix
  [ "$status" -eq 0 ]
  [[ "$output" == *$'\nbase=\n'* ]] || false
}

@test "25 empty integration_branches -> exit 4 resolved-invalid" {
  deploy_edited 's/^integration_branches=.*/integration_branches=/'
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 4 ]
  [[ "$output" == *"resolved=.hskill/init-workflow/resolved.env"* ]] || false
  [[ "$output" == *"verdict=n/a"* ]] || false
  [[ "$output" == *"reason=resolved-invalid"* ]] || false
  [[ "$output" != *"integration="* ]] || false
}

@test "26 missing integration_branches key -> exit 4 resolved-invalid" {
  deploy_edited '/^integration_branches=/d'
  wt="$(linked feature/x)"
  run bash "$SCRIPT" --path "$wt"
  [ "$status" -eq 4 ]
  [[ "$output" == *"reason=resolved-invalid"* ]] || false
}

@test "27 staging with no base.* is still an integration branch, not reusable" {
  deploy_edited '/^base\./d'
  git -C "$REPO" worktree add -q "$TMP/wt" staging
  run bash "$SCRIPT" --path "$TMP/wt"
  [ "$status" -eq 1 ]
  [[ "$output" == *"is_integration=yes"* ]] || false
  [[ "$output" == *"reusable=no"* ]] || false
}
