{
  "toolBundleMeta": {
    "tools": "开发者 OS 工具（hub — 项目管理 + git 状态 + 任务跟踪；sync — Syncthing 守护进程管理）",
    "research-tools": "研究抓取后端（browser-fetch — clip-url/sync-* 共用的认证浏览器抓取 CLI；roster — sync-* 共用的人与渠道名册）"
  },
  "tools": [
    {
      "name": "hub",
      "path": "tools/hub",
      "bundle": "tools",
      "installScope": "essential"
    },
    {
      "name": "sync",
      "path": "tools/sync-agent",
      "bundle": "tools",
      "installScope": "global"
    },
    {
      "name": "browser-fetch",
      "path": "tools/browser-fetch",
      "bundle": "research-tools"
    },
    {
      "name": "roster",
      "path": "tools/roster",
      "bundle": "research-tools"
    }
  ],
  "bundleMeta": {
    "research": "研究工具（learn-video + extract-vision + survey-skillrepo + learn-paper + extract-cognition + probe-session + clip-url + fetch-paper + explain-design + translate-pdf）",
    "feed": "追更工具（manage-creators — 人与渠道名册；sync-xtimeline + sync-ytchannel + sync-website — 按名册跑增量抓取；capture-opinion — 给人记一笔判断）",
    "creative": "创意工具（capture-todo（仅人工调用）+ capture-insight）",
    "coding": "程序工具（init-project + init-workflow + setup-debug + init-goal + capture-vocab + rephrase + explain-pm）",
    "writing": "写作工具（forge-doc + draw-diagram + manage-dir + migrate-spec）",
    "design": "设计工具（scout-brand + build-style + sync-design）",
    "mint": "Skill 生命周期工具（init-skill + publish-skill + archive-skill + dedup-skill + simplify-skill + contribute-skill + fix-skill + runby-opencode + scout-philosophy + learn-skill）",
    "devops": "项目运维工具（clean-git + release-project + sync-hotfix + sync-agent）",
    "agent-canvas": "Agent Canvas 内置 skill（agent-canvas-control — 节点与画布操控；describe-node/relate-node/capture-requirement/relation-review/close-node — 画布节点生命周期治理；capture-intent — 随口需求立成需求节点；judge-release — 对照验收标准逐条取证并写结论；external-closeout — 从外部会话不唤醒目标节点完成收尾）",
    "devflow": "开发流程（question-me — 执行前需求澄清；init-spec — 从初步想法到获批 Spec；develop-plan — 制定实施计划；manage-worktree — 建立或复用、进出与检测 worktree；compose-agentsmd — 从标准骨架生成 AGENTS.md）"
  },
